#!/bin/bash
pushd $(dirname $0)/test
echo "Configuring within $PWD"

export PACKS_URL_BASE=http://packs.download.atmel.com/
PACK_TYPES=(ATautomotive ATmega ATtiny XMEGA)

temp=$(mktemp)
trap "rm '$temp'" EXIT

mkdir -p packs
curl --output packs/index.html "$PACKS_URL_BASE"
# packs.mk is checked in, so date the regenerated copy: a stale pin is then
# obvious from version control rather than from a failed test run.
echo "# Newest pack per family as of $(date -u +%F), regenerate with ./configure" > packs.mk
# The packs index lists each download as a plain anchor, so keep only the
# .atpack hrefs: the page also links to per-pack anchors and product pages.
xmllint --nowarning --html --xpath '//a/@href[contains(.,".atpack")]' packs/index.html |
    sed 's/[^"]*"\([^"]*\)"/\1/g' |
    grep --fixed-strings ${PACK_TYPES[@]/#/-e } |
    sort --reverse --version-sort --unique |
    tee $temp |
    cut --delimiter=. --fields=2 |
    sort --unique |
    xargs --max-args=1 -I{} grep --max-count=1 --fixed-strings {} $temp |
    sed 's/^/PACKS += /' |
    cat >> packs.mk

make --environment-overrides --always-make unpack
